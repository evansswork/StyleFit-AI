# Zero-budget configuration contract, checked by scripts/check-zero-budget.mjs.
# Guest stylist needs no service or API key.
APP_URL=http://localhost:3000
PAID_SERVICES_ENABLED=false
STYLING_ENGINE=rules
AI_PROVIDER=none

# T10: dedicated StyleFit database and Better Auth configuration.
AUTH_ENABLED=false
DATABASE_URL=
STYLEFIT_TEST_DATABASE_URL=
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=

# T11: private persistent storage outside public assets and Git.
MEDIA_ROOT=./private-data/media

# Development email is caught locally by Mailpit; no real email is sent.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM="StyleFit AI <no-reply@example.test>"

# T50: free MET Norway weather; server caching and attribution are required.
MET_NO_USER_AGENT="StyleFit-AI/0.1 https://github.com/evansswork/StyleFit-AI"
