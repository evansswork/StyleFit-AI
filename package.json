{
  "name": "stylefit-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "npm run check:budget",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:budget": "node scripts/check-zero-budget.mjs",
    "test": "node --test scripts/check-zero-budget.test.mjs && vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local ./node_modules/drizzle-kit/bin.cjs migrate",
    "test:account": "node --env-file-if-exists=.env.local scripts/test-account.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.27",
    "better-auth": "1.7.27",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "nodemailer": "10.6.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
